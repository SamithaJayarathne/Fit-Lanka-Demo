<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="180dp"
    android:background="@color/md_theme_surfaceDim"
    android:gravity="bottom"
    android:orientation="vertical"
    android:padding="20dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/nav_header_img"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/profile_24px"
        android:tint="@color/md_theme_onSurface"
        app:shapeAppearanceOverlay="@style/CircleImage"
        app:strokeWidth="2dp" />

    <TextView
        android:id="@+id/nav_header_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Kasun Perera"
        android:textAppearance="@style/TextAppearance.AppCompat.Body2"
        android:textStyle="bold"
        android:textColor="@color/md_theme_onSurface" />

    <TextView
        android:id="@+id/nav_header_points"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1,250 Points Earned"
        android:textColor="@color/md_theme_onSurface"
        android:textSize="12sp" />

</LinearLayout>